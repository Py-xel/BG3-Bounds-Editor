<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ResizeGrip.Base"
       TargetType="{x:Type ResizeGrip}">

        <Setter Property="Margin" Value="0,0,18,18" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ResizeGrip}">
                    <Grid Width="18"
                      Height="18"
                      Background="Transparent">

                        <Line x:Name="Line1"
                          X1="3" Y1="15"
                          X2="15" Y2="3"
                          Stroke="{DynamicResource Brushes.DarkGreen}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Flat"
                          StrokeEndLineCap="Flat" />

                        <Line x:Name="Line2"
                          X1="8" Y1="15"
                          X2="15" Y2="8"
                          Stroke="{DynamicResource Brushes.DarkGreen}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Flat"
                          StrokeEndLineCap="Flat" />

                        <Line x:Name="Line3"
                          X1="13" Y1="15"
                          X2="15" Y2="13"
                          Stroke="{DynamicResource Brushes.DarkGreen}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Flat"
                          StrokeEndLineCap="Flat" />

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>

                                        <ColorAnimation
                                        Storyboard.TargetName="Line1"
                                        Storyboard.TargetProperty="Stroke.Color"
                                        To="Red"
                                        Duration="0:0:0.15" />

                                        <ColorAnimation
                                        Storyboard.TargetName="Line2"
                                        Storyboard.TargetProperty="Stroke.Color"
                                        To="Red"
                                        Duration="0:0:0.15" />

                                        <ColorAnimation
                                        Storyboard.TargetName="Line3"
                                        Storyboard.TargetProperty="Stroke.Color"
                                        To="Red"
                                        Duration="0:0:0.15" />

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>

                                        <ColorAnimation
                                        Storyboard.TargetName="Line1"
                                        Storyboard.TargetProperty="Stroke.Color"
                                        To="#00FF66"
                                        Duration="0:0:0.2" />

                                        <ColorAnimation
                                        Storyboard.TargetName="Line2"
                                        Storyboard.TargetProperty="Stroke.Color"
                                        To="#00FF66"
                                        Duration="0:0:0.2" />

                                        <ColorAnimation
                                        Storyboard.TargetName="Line3"
                                        Storyboard.TargetProperty="Stroke.Color"
                                        To="#00FF66"
                                        Duration="0:0:0.2" />

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>