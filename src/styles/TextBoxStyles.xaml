<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Import Brushes -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- TextBox.Path -->
    <Style x:Key="TextBox.Path" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Brushes.White}"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="5,3,0,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- TextBox.Edit -->
    <Style x:Key="TextBox.Edit" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Brushes.White}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brushes.NeonGreen}" />
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="5,3,0,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,8"/>
    </Style>

</ResourceDictionary>
